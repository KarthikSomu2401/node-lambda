# ============================================
# Server Configuration
# ============================================
# PORT: Server port number (default: 3000)
PORT=3000

# NODE_ENV: Application environment
# Options: development, production, test
NODE_ENV=development

# LOG_LEVEL: Logging verbosity
# Options: error, warn, info, debug, trace
LOG_LEVEL=debug

# ============================================
# Database Configuration
# ============================================
# MONGODB_URI: MongoDB connection string
# For local development:
MONGODB_URI=mongodb://127.0.0.1:27017/note_db

# For MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/note_db?retryWrites=true&w=majority

# MONGODB_TIMEOUT: Connection timeout in milliseconds
MONGODB_TIMEOUT=10000

# ============================================
# AWS Lambda Configuration
# ============================================
# AWS_REGION: AWS region for Lambda deployment
# Examples: us-east-1, us-west-2, eu-west-1
AWS_REGION=us-east-1

# AWS_ACCESS_KEY_ID: AWS access key (for local testing only)
# Get from AWS Console → Security Credentials
# IMPORTANT: Never commit this to version control
AWS_ACCESS_KEY_ID=your_access_key_here

# AWS_SECRET_ACCESS_KEY: AWS secret key (for local testing only)
# Get from AWS Console → Security Credentials
# IMPORTANT: Never commit this to version control
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# ============================================
# Lambda Functions
# ============================================
# AUTO_TAG_LAMBDA_FUNCTION: Name of the auto-tagging Lambda function
AUTO_TAG_LAMBDA_FUNCTION=auto-tag-notes

# ============================================
# Application Configuration
# ============================================
# API_BASE_PATH: Base path for API endpoints
API_BASE_PATH=/

# REQUEST_TIMEOUT: Request timeout in milliseconds
REQUEST_TIMEOUT=30000
